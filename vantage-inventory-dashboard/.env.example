# ─── Backend (Lovable Cloud / Supabase) ───────────────────────────────
# Replace the placeholders with your own project's values.
# On Lovable Cloud these are visible in your project's Backend panel;
# on a self-managed Supabase project, find them in Project Settings > API.

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

# ─── Frontend (Vite exposes any VITE_* var to the browser) ────────────
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# ─── Optional: app/server secret key (server-only, never prefixed with VITE_) ──
# LOVABLE_API_KEY="optional-server-key"
